PORT=5000
NODE_ENV=development

# Frontend Origin for CORS (comma-separated if multiple)
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection URI (Database name: convertx)
# Local example: mongodb://127.0.0.1:27017/convertx
# Atlas example: mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/convertx?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/convertx

# Authentication JWT Secret (Use a strong random secret in production; auto-generated in render.yaml)
JWT_SECRET=replace_with_a_strong_unique_random_secret_in_production

# File Upload & Retention Limits
MAX_FILE_SIZE_MB=25
FILE_RETENTION_MINUTES=30
